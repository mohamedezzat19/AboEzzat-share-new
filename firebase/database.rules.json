{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "devices": { ".indexOn": ["lastSeen", "status"] },
        "commands": { ".indexOn": ["createdAt", "expiresAt", "status"] },
        "events": { ".indexOn": ["createdAt", "type"] }
      }
    }
  }
}
